# Copy this file to ".env" (same folder as docker-compose.yml) and fill it in.
# Docker Compose reads ".env" automatically. NEVER share or commit your real .env.

# --- Real email via Gmail (needs 2-Step Verification + an App Password) ---
# Create the app password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your.address@gmail.com
# SMTP_PASSWORD=your-16-character-app-password
# MAIL_FROM="Your Event Name <your.address@gmail.com>"

# --- Admin login (change these) ---
# ADMIN_TOKEN=a-long-random-secret
# ADMIN_USER=admin
# ADMIN_PASSWORD=a-strong-password
